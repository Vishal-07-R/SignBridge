# ==============================================================================
# AI SignBridge - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI SignBridge"
APP_VERSION="0.1.0"
API_V1_PREFIX=/api/v1
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars!

# Host and Port Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database (PostgreSQL 16)
POSTGRES_USER=signbridge
POSTGRES_PASSWORD=signbridge_dev_secret
POSTGRES_DB=signbridge_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://signbridge:signbridge_dev_secret@localhost:5432/signbridge_dev

# Redis 7 (Cache, Rate Limiting, Celery/RQ Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible private media storage)
MINIO_ENDPOINT=http://localhost:9002
MINIO_ROOT_USER=signbridge_minio
MINIO_ROOT_PASSWORD=signbridge_minio_secret
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_MEDIA=signbridge-media
MINIO_BUCKET_ASSETS=signbridge-assets

# Mailpit (Local development SMTP)
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAIL_FROM_ADDRESS=noreply@signbridge.local
MAIL_FROM_NAME="AI SignBridge Dev"
